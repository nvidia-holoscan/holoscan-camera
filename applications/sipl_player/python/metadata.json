{
    "$schema": "urn:holohub:application:v1",
    "application": {
        "name": "sipl_player",
        "authors": [
            {
                "name": "Holoscan Team",
                "affiliation": "NVIDIA"
            }
        ],
        "description": "Shows live video from every camera of an NvSIPL camera configuration with HoloViz",
        "language": "Python",
        "version": "0.1.0",
        "changelog": {
            "0.1.0": "Initial implementation, ported from Holoscan Sensor Bridge's sipl_player.py"
        },
        "holoscan_sdk": {
            "minimum_required_version": "5.0.0",
            "tested_versions": ["5.0.0"]
        },
        "platforms": ["aarch64"],
        "tags": ["Camera", "SIPL", "Jetson", "Visualization", "Python"],
        "ranking": 3,
        "requirements": {
            "python": "CPython 3.12 or newer with matching Holoscan SDK 5 Python bindings, including Vision and Visualization, and CuPy",
            "linux": "NvSIPL runtime and development headers",
            "display": "A display, unless run with --headless"
        },
        "default_mode": "run",
        "modes": {
            "run": {
                "description": "Show every camera of the SIPL camera configuration in one HoloViz window",
                "run": {
                    "command": "bash \"<holohub_root>/python/run_sample.sh\" \"<holohub_root>/applications/sipl_player/python/sipl_player.py\"",
                    "workdir": "holohub_root",
                    "docker_run_args": [
                        "--privileged"
                    ]
                }
            },
            "validate": {
                "description": "Compile the Python player's graph for two placeholder cameras without opening a camera",
                "run": {
                    "command": "bash \"<holohub_root>/python/run_sample.sh\" \"<holohub_root>/applications/sipl_player/python/sipl_player.py\" --validate",
                    "workdir": "holohub_root"
                }
            }
        }
    }
}
