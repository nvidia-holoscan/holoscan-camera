{
    "$schema": "urn:holohub:application:v1",
    "application": {
        "name": "sipl_player",
        "authors": [
            {
                "name": "Gil Shapira",
                "affiliation": "NVIDIA"
            }
        ],
        "description": "Shows live video from every camera of an NvSIPL camera configuration with HoloViz",
        "language": "C++",
        "version": "0.1.0",
        "changelog": {
            "0.1.0": "Initial implementation, ported from Holoscan Sensor Bridge's sipl_player"
        },
        "holoscan_sdk": {
            "minimum_required_version": "5.0.0",
            "tested_versions": ["5.0.0"]
        },
        "platforms": ["aarch64"],
        "tags": ["Camera", "CUDA", "SIPL", "Jetson", "Visualization"],
        "ranking": 3,
        "requirements": {
            "required": ["NvSIPL dev packages (NvSIPLCamera.hpp)", "A display, unless run with --headless"]
        },
        "default_mode": "run",
        "modes": {
            "run": {
                "description": "Show every camera of the SIPL camera configuration in one HoloViz window",
                "run": {
                    "command": "\"<holohub_app_bin>/sipl_player\"",
                    "workdir": "holohub_root",
                    "docker_run_args": [
                        "--privileged"
                    ]
                }
            }
        }
    }
}
